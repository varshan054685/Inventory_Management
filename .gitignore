# Dependencies
node_modules/

# Build outputs
dist/
dist-electron/

# Electron builder output (installers/binaries — too large for git)
release/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Vite cache
.vite/

# TypeScript build info
*.tsbuildinfo

# Test coverage
coverage/

# Database files (local business data — never commit)
*.db
*.db-journal
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
data/

# Backups (plaintext + encrypted) — sensitive business data
*.enc
*.backup
*.bak
backups/

# Temporary test databases created by the test suite
/tmp-manager-*.sqlite

# Env files / secrets
.env
.env.local
.env.*.local

# Code signing certificates & private keys (NEVER commit)
*.pfx
*.p12
*.pem
*.key
*.cer
*.crt
build/*.pfx
build/*.p12

# Editor / IDE
.vscode/
.idea/
*.code-workspace

# Misc
.eslintcache
*.orig
*.rej
