{
  "name": "inventory-management-system",
  "version": "1.0.2",
  "description": "Offline-first Windows desktop app for inventory management",
  "author": "Inventory Management System",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/varshan054685/Inventory_Management.git"
  },
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev:web": "vite",
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev:electron:full": "npm run build:electron && npm run dev",
    "build": "npm run build:web && npm run build:electron",
    "build:web": "vite build",
    "build:electron": "esbuild electron/main.ts electron/preload.ts electron/shared/appInfo.ts --bundle --platform=node --external:electron --outdir=dist-electron --format=cjs --target=node18",
    "build:all": "npm run build && electron-builder",
    "dist": "npm run build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "electron-builder install-app-deps || true"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.441.0",
    "pdfmake": "^0.2.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "recharts": "^2.12.7",
    "sql.js": "^1.10.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/pdfmake": "^0.2.9",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.23.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "^2.0.5",
    "wait-on": "^8.0.1"
  }
}
